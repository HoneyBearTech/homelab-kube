# Secrets and per-site settings never belong here: tokens, kubeconfigs, certificates, keys
.env
.env.*
*.kubeconfig
kubeconfig*
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# Release and CI outputs (generated by the workflows, never committed)
sbom.cdx.json
*.cdx.json
SHA256SUMS*
*.tar.gz
*.intoto.jsonl
*.sigstore.json

# The old in-repo vault path; project notes live in Chronos, never here
.obsidian-docs/

# Python tooling for scripts/ and tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
